{
  "name": "@arena/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "backfill-compress-matches": "tsx --env-file=.env scripts/backfill-compress-matches.ts",
    "backfill-reparse-participants": "tsx --env-file=.env scripts/backfill-reparse-participants.ts",
    "backfill-rounds": "tsx --env-file=.env scripts/backfill-rounds.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@arena/types": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@arena/eslint-config": "workspace:*",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.6",
    "eslint": "^10.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
