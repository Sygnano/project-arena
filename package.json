{
  "name": "arena-stats",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @arena/db generate",
    "db:migrate": "pnpm --filter @arena/db migrate",
    "format": "turbo run //#prettier:write",
    "format:check": "turbo run //#prettier:check",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
