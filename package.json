{
  "name": "arena-stats",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run //#biome:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @arena/db generate",
    "db:migrate": "pnpm --filter @arena/db migrate",
    "script:api": "node scripts/run-api-script.mjs",
    "format": "turbo run //#biome:write",
    "biome:check": "biome check .",
    "biome:write": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
