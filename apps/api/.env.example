# Postgres connection string (local Postgres for dev, or a hosted one later).
DATABASE_URL=postgres://arena:change-me@localhost:5432/arena

# Optional: a role allowed to change the schema, used only for the startup
# migrations. Set it when DATABASE_URL's role can only read and write rows.
# MIGRATION_DATABASE_URL=postgres://arena_owner:change-me@localhost:5432/arena

# The Riot gateway (apps/riot-gateway), which holds the Riot API key: every
# Riot call goes through it. Defaults to http://localhost:3002.
# RIOT_GATEWAY_URL=http://localhost:3002
# Same value as the gateway's RIOT_GATEWAY_SECRET, when it has one.
# RIOT_GATEWAY_SECRET=

# Shared with the web app (same value in apps/web). Once set, every route but
# /health refuses requests without it. Required in production; at least 32
# characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# API_PROXY_SECRET=

PORT=3001
