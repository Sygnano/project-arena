# Postgres connection string (Neon/Supabase dev branch, or self-hosted later).
DATABASE_URL=postgres://user:password@host:5432/arena_stats

# Personal/dev Riot API key from https://developer.riotgames.com/
# (expires periodically on a dev key — regenerate and update as needed).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

PORT=3001

# How often (in minutes) the background loop polls every tracked summoner
# for new Arena matches.
INGESTION_INTERVAL_MINUTES=15
