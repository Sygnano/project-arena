{
  "name": "@arena/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "node build.mjs server",
    "build:scripts": "node build.mjs scripts",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "crawl": "tsx --env-file-if-exists=.env scripts/crawl.ts",
    "crawl:forever": "tsx --env-file-if-exists=.env scripts/crawl.ts --forever",
    "crawl:leaderboard": "tsx --env-file-if-exists=.env scripts/crawl-leaderboard.ts",
    "check-recaps": "tsx --env-file-if-exists=.env scripts/check-recaps.ts",
    "retry-skipped": "tsx --env-file-if-exists=.env scripts/retry-skipped.ts"
  },
  "dependencies": {
    "@arena/db": "workspace:*",
    "@arena/riot": "workspace:*",
    "@arena/types": "workspace:*",
    "fastify": "^5.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@arena/bundle": "workspace:*",
    "@arena/eslint-config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^10.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
