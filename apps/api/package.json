{
  "name": "@arena/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "crawl": "tsx --env-file-if-exists=.env scripts/crawl.ts",
    "crawl:forever": "tsx --env-file-if-exists=.env scripts/crawl.ts --forever"
  },
  "dependencies": {
    "@arena/db": "workspace:*",
    "@arena/types": "workspace:*",
    "fastify": "^5.2.1",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
