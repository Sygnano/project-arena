{
  "name": "@arena/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "backfill-missing-timelines": "tsx --env-file=.env scripts/backfill-missing-timelines.ts",
    "crawl": "tsx --env-file=.env scripts/crawl.ts"
  },
  "dependencies": {
    "@arena/db": "workspace:*",
    "@arena/types": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
