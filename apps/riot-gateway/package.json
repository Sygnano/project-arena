{
  "name": "@arena/riot-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arena/riot": "workspace:*",
    "@arena/types": "workspace:*",
    "fastify": "^5.2.1",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@arena/bundle": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
