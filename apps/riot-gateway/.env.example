# Riot API key from https://developer.riotgames.com/ (a dev key expires every
# 24h; a production key doesn't). Only this service holds it.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Shared with every caller (apps/api and its scripts: same value there).
# Once set, every route but /health refuses requests without it. Required in
# production; at least 32 characters, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# RIOT_GATEWAY_SECRET=

PORT=3002
